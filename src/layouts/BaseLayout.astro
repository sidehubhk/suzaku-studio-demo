---
import '../styles/global.css';
import ReviewGate from '../components/ReviewGate';
import ReviewShield from '../components/ReviewShield';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SUZAKU Games | Private Client Review',
  description = 'Confidential client review build. Unauthorized distribution prohibited.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030306" />
    <meta http-equiv="Cache-Control" content="no-store" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Shippori+Mincho:wght@400;500;600;700&family=Sora:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="relative bg-void text-bone antialiased">
    <div class="pointer-events-none fixed inset-0 z-[60] grain" aria-hidden="true"></div>
    <div class="pointer-events-none fixed inset-0 z-[59] scanlines opacity-40" aria-hidden="true"></div>
    <div class="pointer-events-none fixed inset-0 z-[58] vignette" aria-hidden="true"></div>
    <ReviewGate client:load />
    <ReviewShield client:load />
    <slot />
  </body>
</html>
