---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SUZAKU Games | Cyberpunk & Horror Indie Studio',
  description = 'SUZAKU is a game studio founded on pure escapism — cyberpunk atmospheres and East Asian ghost stories.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030306" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Shippori+Mincho:wght@400;500;600;700&family=Sora:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="relative bg-void text-bone antialiased">
    <div class="pointer-events-none fixed inset-0 z-[60] grain" aria-hidden="true"></div>
    <div class="pointer-events-none fixed inset-0 z-[59] scanlines opacity-40" aria-hidden="true"></div>
    <slot />
  </body>
</html>
