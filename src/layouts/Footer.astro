---
import { STUDIO_LOGO } from '../data/brand';
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-void py-12">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-8 px-5 md:flex-row md:items-center md:justify-between md:px-8"
  >
    <div class="max-w-md">
      <img src={STUDIO_LOGO} alt="SUZAKU Games" class="mb-4 h-9 w-auto object-contain" />
      <p class="font-display text-sm tracking-[0.28em] uppercase text-bone">SUZAKU Studio</p>
      <p class="mt-2 font-serif text-sm text-mute">
        Demo rebuild for client preview — cyberpunk &amp; horror atmosphere inspired by the studio
        catalog.
      </p>
    </div>
    <div class="flex flex-wrap gap-5 font-display text-xs tracking-[0.2em] uppercase text-mute">
      <a class="transition hover:text-neon" href="https://www.suzakugamestudio.com/" target="_blank" rel="noreferrer"
        >Original Site</a
      >
      <a class="transition hover:text-neon" href="https://www.patreon.com/suzaku_games" target="_blank" rel="noreferrer"
        >Patreon</a
      >
      <a class="transition hover:text-neon" href="https://x.com/SUZAKU_Games" target="_blank" rel="noreferrer">X</a>
      <span class="text-fog">© {year}</span>
    </div>
  </div>
</footer>
